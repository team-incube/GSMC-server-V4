input PatchMemberSchoolInfoInput {
    memberId: ID!
    grade: Int
    classNumber: Int
    number: Int
}

extend type Mutation {
    patchMemberSchoolInfo(input: PatchMemberSchoolInfoInput!): Boolean!
    patchMemberRole(input: PatchMemberRoleInput!): Boolean!
}

input PatchMemberRoleInput {
    email: String!
    role: UserRole!
}

type Score {
    scoreId: ID!
    userId: ID!
    category: Category!
    evidence: Evidence
    scoreStatus: ScoreStatus
    activityName: String
}

enum ScoreStatus {
    INCOMPLETE
    PENDING
    APPROVED
    REJECTED
}

input ScoreInput {
    value: String
    fileId: ID
    evidenceId: ID
}

input UpdateScoreStatusInput {
    scoreStatus: ScoreStatus!
}

input RejectScoreInput {
    rejectionReason: String!
}

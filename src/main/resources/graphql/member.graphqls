enum SortDirection {
    ASC
    DESC
}

input SearchMemberInput {
    email: String
    name: String
    role: UserRole
    grade: Int
    classNumber: Int
    number: Int
    limit: Int = 100
    page: Int = 0
    sortBy: SortDirection = ASC
}

input PatchMemberRoleInput {
    email: String!
    role: UserRole!
}

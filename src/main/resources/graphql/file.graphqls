type File {
    fileId: ID!
    userId: ID!
    fileUri: String
    fileOriginalName: String
    fileStoredName: String
}

input CreatePresignedUploadUrlInput {
    fileName: String!
    fileSize: Long!
    contentType: String!
}

input ConfirmFileUploadInput {
    fileKey: String!
    originalFileName: String!
}
